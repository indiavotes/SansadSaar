{
  // SansadSaar, served at www.indiavotes.com/sansadsaar/ by route on the
  // indiavotes.com zone (account nayidisha01), the same pattern as Netas:
  // Worker routes take precedence over the main site's custom domain for
  // these paths. build.command stages the served files into
  // ./public/sansadsaar/, because a route Worker receives the full path.
  // Serving from a dedicated public/ keeps .git, plan/, scripts/ and config
  // off the edge. Push to `staging` deploys env.staging; push to `main`
  // deploys production (.github/workflows/deploy.yml).
  "name": "sansadsaar",
  "account_id": "1952b3d3f931d0a504cf8e9822c64f56",
  "compatibility_date": "2026-05-14",
  "main": "src/worker.js",
  "build": {
    "command": "rm -rf public && mkdir -p public/sansadsaar && cp -r index.html app guide feeds public/sansadsaar/ && find public -name .DS_Store -delete"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.indiavotes.com/sansadsaar", "zone_name": "indiavotes.com" },
    { "pattern": "www.indiavotes.com/sansadsaar/*", "zone_name": "indiavotes.com" },
    { "pattern": "indiavotes.com/sansadsaar", "zone_name": "indiavotes.com" },
    { "pattern": "indiavotes.com/sansadsaar/*", "zone_name": "indiavotes.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "sansadsaar-staging",
      "routes": [
        { "pattern": "staging.indiavotes.com/sansadsaar", "zone_name": "indiavotes.com" },
        { "pattern": "staging.indiavotes.com/sansadsaar/*", "zone_name": "indiavotes.com" }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": { "NOINDEX": "1" }
    }
  }
}
